# ==========================================
# URL Shortener Platform - Environment Configuration
# ==========================================

# 1. Application & Domain Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_DOMAIN=localhost:3000
NODE_ENV=development

# 2. Database & Redis Cache Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener?schema=public
REDIS_URL=redis://localhost:6379

# 3. Neon S3 Object Storage (Assets, Logos, QR Codes)
AWS_ENDPOINT_URL_S3=https://your-neon-s3-endpoint.storage.aws.neon.tech
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-2

# 4. Security, Threat Intelligence & Risk Analysis
SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# 5. Authentication, Webhooks & Secrets
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long
WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
